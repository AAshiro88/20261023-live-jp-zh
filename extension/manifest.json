{
  "manifest_version": 3,
  "name": "Live JP-ZH Captions",
  "version": "1.0.1",
  "description": "Captures the current tab's audio and streams it to the local live-jp-zh caption server.",
  "permissions": ["tabCapture", "offscreen", "storage"],
  "action": {
    "default_title": "Live JP-ZH Captions：點擊擷取此分頁音訊",
    "default_icon": {
      "16": "icons/idle_16.png",
      "32": "icons/idle_32.png",
      "48": "icons/idle_48.png"
    }
  },
  "icons": {
    "16": "icons/idle_16.png",
    "32": "icons/idle_32.png",
    "48": "icons/idle_48.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
