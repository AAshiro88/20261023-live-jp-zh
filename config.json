  "vad": {
    "threshold": 0.5,
    "min_silence_duration_ms": 500,
    "min_speech_duration_ms": 300,
    "max_utterance_seconds": 12.0,
    "preroll_seconds": 0.3
  },
  "audio_block_seconds": 0.22,
  "translate": {
    "enabled": true,
    "gguf_path": "models\\Qwen3-4B-Instruct-2507-Q4_K_M.gguf",
    "n_ctx": 4096,
    "n_gpu_layers": 0,
    "n_threads": -1,
    "temperature": 0.15,
    "max_tokens": 200,
    "history_turns": 3,
    "skip_if_pending": 3
  },
  "output": {
    "opencc_config": "s2twp",
    "transcript_dir": "transcript",
    "max_lines_on_page": 12
  }
